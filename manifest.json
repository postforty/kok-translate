{
  "manifest_version": 3,
  "name": "KokTranslate",
  "version": "1.0",
  "description": "웹페이지 요소를 콕! 찍어 바로 번역하는 LLM 기반 크롬 확장 프로그램",
  "permissions": ["activeTab", "scripting", "storage"],
  "options_page": "options.html",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon_128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon_128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
